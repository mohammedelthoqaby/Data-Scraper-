<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LazyBean Collector: the Windows desktop app that collects Strong Coffee and Meta ads from a PC
    with a residential connection. Published as one self-contained win-x64 exe (LazyBeanCollector.exe).
    It reuses the collection code in backend/src/LazyBean.Collectors, so the server and the app run the
    same adapters, HTTP politeness rules and Meta port.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LazyBeanCollector</AssemblyName>
    <RootNamespace>LazyBean.Collector.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en;ar</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Company>LazyBean</Company>
    <Product>LazyBean Collector</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\src\LazyBean.Collectors\LazyBean.Collectors.csproj" />
  </ItemGroup>

</Project>

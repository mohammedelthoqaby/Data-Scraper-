{
  "App": {
    "PublicBaseUrl": "https://lazy-bean.runasp.net"
  },
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Admin": {
    "Username": "",
    "Password": ""
  },
  "ForwardedHeaders": {
    "TrustedNetworks": [
      "127.0.0.1/32",
      "::1/128"
    ]
  },
  "Collection": {
    "Shopify": {
      "MaxPages": 250,
      "TimeoutSeconds": 1500
    }
  },
  "Security": {
    "UseHttpsRedirection": false,
    "NetlifyProxySecret": ""
  },
  "Internal": {
    "Token": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b918857e-a920-44c2-9713-b351ab8a239e</UserSecretsId>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LazyBean.Application\LazyBean.Application.csproj" />
    <ProjectReference Include="..\LazyBean.Infrastructure\LazyBean.Infrastructure.csproj" />
    <ProjectReference Include="..\LazyBean.Domain\LazyBean.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="seed\competitors.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="BuildWebAndCopyWwwroot" BeforeTargets="AssignTargetPaths">
    <Message Text="Building web frontend and copying to wwwroot..." Importance="high" />
    <Exec Command="npm ci --prefix ../../../web" Condition="!Exists('../../../web/node_modules')" ContinueOnError="false" />
    <Exec Command="npm run build --prefix ../../../web" ContinueOnError="false" />
    <ItemGroup>
      <DistFiles Include="..\..\..\web\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DistFiles)" DestinationFolder="wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared collection code used by the server (LazyBean.Infrastructure) and the Windows desktop
    collector (LazyBeanCollector). Everything that talks to Strong Coffee, Meta or Google lives here,
    so both hosts run the same logic. Depends on Application only for the adapter/HTTP contracts.
  -->

  <ItemGroup>
    <ProjectReference Include="..\LazyBean.Application\LazyBean.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LazyBean.Collectors</RootNamespace>
  </PropertyGroup>

</Project>
